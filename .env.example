# Copy to .env (git-ignored) and fill in. The backend reads it at startup (and docker compose passes it to the
# container); variables already set in the shell win.

# Required: every pipeline LLM call goes to OpenRouter (backend/llm.openrouter.toml). https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Host port for the backend / demo UI (docker compose only). Default 8000.
# PORT=8765

# Optional: OCR for scanned PDFs and images (backend/application/modules/ingestion/vlm.py). Without these, .docx and
# text PDFs still work; a scan or photo fails with "image input needs OCR". Any OpenAI-compatible vision model.
# OCR_API_KEY=
# OCR_MODEL=
# OCR_BASE_URL=https://openrouter.ai/api/v1

# Optional
# LOG_LEVEL=INFO
# GEMINI_API_KEY=
