{
  "version": "2.0.0",
  "tasks": [

    {
    "label": "Backend: Run server",
    "type": "process",
    "command": "${workspaceFolder}\\backend\\.venv\\Scripts\\python.exe",
    "args": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--app-dir",
        "backend",
        "--reload",
        "--log-level",
        "info",
        "--access-log"
    ],
    "options": {
        "cwd": "${workspaceFolder}"
    },
    "isBackground": true,
    "problemMatcher": []
    },    
    {
      "label": "Frontend: Run server",
      "type": "process",
      "command": "npm.cmd",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}\\frontend"
      },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}