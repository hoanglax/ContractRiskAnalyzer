graph TB
    IN["ingest(file): TXT / DOCX / DOC / text-layer PDF"]
    LOAD["_load + guards: empty, >50MB"]
    SNIFF["sniff: magic bytes; images recognised only to reject"]
    ROUTE{"ROUTES[kind]"}
    ERR["IngestError: unsupported_type, no_text, encrypted, conversion_failed"]
    TXT["route_txt: decode text"]
    DOCX["route_docx: paragraphs, tables, numbering"]
    DOC["route_doc: LibreOffice to DOCX"]
    PDF["route_pdf: extract and check every page"]
    FIN["_finish: quality checks and text clause map"]
    OUT["Document: text, source, blocks, pages, warnings"]
    IN --> LOAD --> SNIFF --> ROUTE
    LOAD -.-> ERR
    ROUTE --> TXT & DOCX & DOC & PDF
    ROUTE -->|image or unsupported| ERR
    TXT & DOCX & DOC & PDF --> FIN --> OUT
    PDF -.->|unreadable page| ERR
    FIN -.->|unreadable text| ERR
