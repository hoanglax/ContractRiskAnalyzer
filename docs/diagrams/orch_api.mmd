graph TB
    FE["Frontend"] -->|"POST /analyses (file)"| UP["run.create: save upload as runs/id.upload,<br/>new 12-hex id, status = queued"]
    UP -->|"201: id"| FE
    UP --> BG["background task (same process, no queue);<br/>one analysis at a time, later ones wait as queued"]
    BG --> S1["M1 ingest -> Document (M2 clause map added inside ingest)"]
    S1 -->|"IngestError (code)"| FAIL["status = failed, error code + message"]
    S1 --> S3["M3 detection.pipeline.run -> Findings (taxonomy codes)"]
    S3 -->|"LLMError -> llm_error;<br/>nothing readable -> detection_failed"| FAIL
    S3 --> S4["M4 legal basis per finding<br/>(a failed call: warning, empty basis)"]
    S4 --> S6["M6 one explanation per clause Item<br/>(a failed call: warning, no explanation)"]
    S6 --> DONE["status = done"]
    BG -.->|"after each stage"| ST["runs/id.json: status, stage, warnings (by stage),<br/>document, findings, bases, items, calls,<br/>versions (commit, prompt hashes, taxonomy, model per task)"]
    DONE --> ST
    FAIL --> ST
    BG -->|"unexpected exception"| FAIL
    FE -->|"GET /analyses/{id} (poll)"| GET["run.load: id must be 12 hex, else 404"]
    ST --> GET
    GET -->|"queued | running(stage) | done(result) | failed(error)"| FE
