graph TB
    PT["pdftotext per page + pdfinfo page count"]
    Q{"every page has readable text?"}
    ERR["no_text: reject whole PDF; no OCR or partial analysis"]
    SHORT["short readable page: keep; warn except short last signature page"]
    JOIN["join_pages: remove running headers, footers, page numbers"]
    EMPTY{"any page has no body text after cleanup?"}
    OUT["Document: native pages, quality, low_text_pages, removed_lines"]
    PT --> Q
    Q -->|empty or broken text layer| ERR
    Q -->|readable| SHORT --> JOIN --> EMPTY
    EMPTY -->|yes| ERR
    EMPTY -->|no| OUT
